{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Two of these are load-bearing, not taste:
  //
  //   *.mdx — oxfmt has no MDX parser. It formats .mdx as Markdown and turns a
  //   multi-line `{/* … */}` JSX comment into `{/_ … _/}`, which fails the
  //   Storybook build with "Could not parse expression with acorn".
  //
  //   package.json — release-please rewrites the version on every release.
  //   Sorting the keys moves other keys up against that line, so the formatter
  //   and the release bot fight over the same hunk and every open PR conflicts.
  //   The root package.json is not release-managed and is still sorted.
  "ignorePatterns": ["CHANGELOG.md", "icons/*", "**/*.mdx", "package.json"],
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "jsxSingleQuote": false,
  "printWidth": 80,
  // "experimentalSortPackageJson": true,
  "experimentalSortImports": {
    "groups": [
      ["side-effect"],
      ["builtin"],
      ["external", "type-external"],
      ["internal", "type-internal"],
      ["parent", "type-parent"],
      ["sibling", "type-sibling"],
      ["index", "type-index"],
    ],
    "internalPattern": ["@/", "~/"],
    "newlinesBetween": false,
  },

  // oxfmt never loads prettier plugins: it is a Rust formatter and its config
  // has no "plugins" option. Both plugins this file used to ask for now have
  // native equivalents. prettier-plugin-organize-imports is the
  // experimentalSortImports block above; prettier-plugin-tailwindcss shipped as
  // "experimentalTailwindcss" (oxc-project/oxc#16542), running the same sorting
  // algorithm. Enabling the latter here needs `config: "./tailwind.config.ts"`
  // (this package is on Tailwind v3, unlike react-native, which points at a v4
  // stylesheet) and `functions: ["cn", "cva"]`. It re-sorts the classes in ~164
  // files under src/, so it wants its own PR and its own Chromatic review.
}
